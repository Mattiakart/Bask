# Canonical public URL of the site (what visitors type). No trailing slash.
# Custom domain:     https://baskinwardrobe.example
# GitHub project Pages: https://username.github.io/Bask   ← include the /Bask
NEXT_PUBLIC_SITE_URL=https://baskinwardrobe.example

# Optional: origin baked into the OVH test branch (cursor/test-site-2cf4).
# Falls back to NEXT_PUBLIC_SITE_URL when unset.
# NEXT_PUBLIC_TEST_SITE_URL=https://test.baskinwardrobe.example

# Required for static hosting (npm run build:static / OVH hosting branches /
# any host that only serves files). A static host cannot run /api/waitlist, so
# the form posts here instead — a Formspree, Getform, Basin, or similar URL.
# NEXT_PUBLIC_WAITLIST_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Only if the site is served from a subdirectory (Next basePath), e.g.
# username.github.io/Bask. Must match the path segment in NEXT_PUBLIC_SITE_URL.
# Leave unset for a custom domain or an apex GitHub Pages site.
# NEXT_PUBLIC_BASE_PATH=/Bask
