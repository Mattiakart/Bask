# Canonical origin. Used for the canonical link, Open Graph tags, robots.txt
# and the sitemap. No trailing slash needed — it is stripped either way.
NEXT_PUBLIC_SITE_URL=https://baskinwardrobe.example

# Required for static hosting (npm run build:static / GitHub Pages / Netlify /
# any host that only serves files). A static host cannot run /api/waitlist, so
# the form posts here instead — a Formspree, Getform, Basin, or similar URL.
# NEXT_PUBLIC_WAITLIST_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Only if the site is served from a subdirectory, e.g. username.github.io/Bask.
# Leave unset for a custom domain or an apex GitHub Pages site.
# NEXT_PUBLIC_BASE_PATH=/Bask
